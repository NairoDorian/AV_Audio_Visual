{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "topFilesLength": 15,
    "compress": false,
    "headerText": "AV_AudioVisual whole-repository pack, generated by `bun run repomix` from the working tree. Do not edit."
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output.xml",
      "references/**",
      "bun.lock",
      "Cargo.lock",
      "src-tauri/icons/**",
      "test/fixtures/**"
    ]
  },
  "security": { "enableSecurityCheck": true }
}
